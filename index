per%20--%3E%0A%20%20%3Cg%20transform%3D%27translate%2850%2C500%29%27%20stroke%3D%27%2523b8860b%27%20fill%3D%27none%27%20stroke-width%3D%275%27%3E%0A%20%20%20%20%3Crect%20x%3D%270%27%20y%3D%2710%27%20width%3D%27240%27%20height%3D%2718%27%20rx%3D%273%27/%3E%0A%20%20%20%20%3Crect%20x%3D%270%27%20y%3D%270%27%20width%3D%2718%27%20height%3D%2750%27%20rx%3D%273%27/%3E%0A%20%20%20%20%3Crect%20x%3D%27100%27%20y%3D%270%27%20width%3D%2714%27%20height%3D%2750%27%20rx%3D%273%27/%3E%0A%20%20%20%20%3Cline%20x1%3D%270%27%20y1%3D%2728%27%20x2%3D%27-20%27%20y2%3D%2728%27/%3E%0A%20%20%20%20%3Cline%20x1%3D%270%27%20y1%3D%2728%27%20x2%3D%270%27%20y2%3D%2758%27/%3E%0A%20%20%20%20%3Cline%20x1%3D%27114%27%20y1%3D%2728%27%20x2%3D%27134%27%20y2%3D%2728%27/%3E%0A%20%20%20%20%3Cline%20x1%3D%27114%27%20y1%3D%2728%27%20x2%3D%27114%27%20y2%3D%2758%27/%3E%0A%20%20%3C/g%3E%0A%20%20%3C%21--%20Blueprint%20lines%20scattered%20--%3E%0A%20%20%3Cg%20stroke%3D%27%2523b8860b%27%20fill%3D%27none%27%20stroke-width%3D%272%27%20stroke-dasharray%3D%278%2C6%27%20opacity%3D%270.6%27%3E%0A%20%20%20%20%3Cline%20x1%3D%27300%27%20y1%3D%27200%27%20x2%3D%27500%27%20y2%3D%27200%27/%3E%0A%20%20%20%20%3Cline%20x1%3D%27400%27%20y1%3D%27150%27%20x2%3D%27400%27%20y2%3D%27350%27/%3E%0A%20%20%20%20%3Ccircle%20cx%3D%27400%27%20cy%3D%27200%27%20r%3D%2760%27/%3E%0A%20%20%20%20%3Cline%20x1%3D%27800%27%20y1%3D%27600%27%20x2%3D%271000%27%20y2%3D%27600%27/%3E%0A%20%20%20%20%3Cline%20x1%3D%27900%27%20y1%3D%27550%27%20x2%3D%27900%27%20y2%3D%27700%27/%3E%0A%20%20%20%20%3Crect%20x%3D%27840%27%20y%3D%27550%27%20width%3D%27120%27%20height%3D%27100%27/%3E%0A%20%20%3C/g%3E%0A%20%20%3C%21--%20Hexagons%20%28nuts%29%20--%3E%0A%20%20%3Cg%20stroke%3D%27%2523b8860b%27%20fill%3D%27none%27%20stroke-width%3D%275%27%3E%0A%20%20%20%20%3Cpolygon%20points%3D%271050%2C350%201080%2C334%201110%2C350%201110%2C382%201080%2C398%201050%2C382%27%20/%3E%0A%20%20%20%20%3Ccircle%20cx%3D%271080%27%20cy%3D%27366%27%20r%3D%2716%27/%3E%0A%20%20%20%20%3Cpolygon%20points%3D%27200%2C350%20222%2C338%20244%2C350%20244%2C374%20222%2C386%20200%2C374%27/%3E%0A%20%20%20%20%3Ccircle%20cx%3D%27222%27%20cy%3D%27362%27%20r%3D%2712%27/%3E%0A%20%20%3C/g%3E%0A%3C/svg%3E");
    background-repeat: repeat;
    background-size: 1200px 900px;
    pointer-events: none;
    z-index: 0;
  }
  /* Sun */
  body::after {
    content: '';
    position: fixed;
    top: -100px; left: 50%; transform: translateX(-50%);
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(255,220,60,.7) 0%, rgba(255,160,40,.25) 45%, transparent 70%);
    pointer-events: none;
    border-radius: 50%;
    z-index: 0;
    animation: sunpulse 6s ease-in-out infinite;
  }
  @keyframes sunpulse {
    0%,100% { opacity:.8; transform:translateX(-50%) scale(1); }
    50% { opacity:1; transform:translateX(-50%) scale(1.08); }
  }

  /* All content above bg */
  body > * { position: relative; z-index: 1; }

  .divider {
    display:flex; align-items:center; gap:12px;
    justify-content:center; margin:0 auto 2rem;
    color:var(--gold); font-size:.78rem; letter-spacing:.22em;
  }
  .divider::before, .divider::after {
    content:''; flex:1; max-width:80px; height:1px;
    background: linear-gradient(90deg, transparent, var(--gold));
  }
  .divider::after { background: linear-gradient(90deg, var(--gold), transparent); }

  /* ── HERO ── */
  .hero {
    min-height:100vh;
    display:flex; flex-direction:column;
    align-items:center; justify-content:center;
    text-align:center; padding:100px 24px 70px;
  }
  .hero-title-wrap { margin-bottom:1.2rem; }
  .hero-logo {
    font-family:'Shippori Mincho',serif;
    font-size:clamp(1.8rem,5vw,3rem);
    font-weight:700; color:var(--text-main);
    letter-spacing:.25em;
    text-shadow: 0 2px 12px rgba(255,220,80,.8), 0 1px 0 rgba(255,255,255,.6);
  }
  .hero-sub-name {
    font-size:.8rem; letter-spacing:.35em; color:var(--gold);
    border-top:1px solid var(--border);
    padding-top:6px; margin-top:4px;
  }
  .hero-tagline {
    font-size:clamp(1.1rem,3.5vw,1.75rem); font-weight:600;
    color:var(--text-main); letter-spacing:.05em;
    margin-bottom:1.4rem;
    text-shadow: 0 1px 6px rgba(255,255,255,.7);
  }
  .hero-desc {
    color:var(--text-sub); font-size:.95rem;
    max-width:480px; line-height:2;
    margin-bottom:2rem;
    background:rgba(255,252,235,.72);
    padding:16px 22px; border-radius:10px;
    border:1px solid rgba(184,134,11,.2);
    backdrop-filter:blur(4px);
  }

  /* ── Buttons ── */
  .contact-buttons {
    display:flex; flex-wrap:wrap; gap:14px; justify-content:center;
  }
  .btn {
    display:inline-flex; align-items:center; gap:10px;
    padding:12px 22px;
    border:1.5px solid var(--border);
    background:rgba(255,252,235,.88);
    color:var(--text-main);
    font-family:'Noto Serif JP',serif;
    font-size:.88rem; letter-spacing:.08em;
    text-decoration:none;
    border-radius:50px;
    box-shadow:0 2px 14px rgba(184,134,11,.14);
    transition:all .25s;
    font-weight:600;
    backdrop-filter:blur(4px);
  }
  .btn:hover {
    background:rgba(255,245,190,.96);
    box-shadow:0 5px 22px rgba(184,134,11,.28);
    transform:translateY(-2px);
  }
  .btn-icon {
    width:32px; height:32px; border-radius:8px;
    overflow:hidden; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
  }
  .btn-icon img { width:100%; height:100%; object-fit:cover; border-radius:8px; }

  section {
    padding:60px 24px; max-width:860px; margin:0 auto;
  }
  .panel {
    background:var(--card-bg);
    border:1px solid var(--border);
    border-radius:14px; padding:32px;
    box-shadow:0 2px 18px rgba(184,134,11,.09);
    backdrop-filter:blur(6px);
  }

  /* ── About ── */
  .about-grid {
    display:grid; grid-template-columns:1fr 1fr; gap:32px; align-items:center;
  }
  @media(max-width:600px){ .about-grid{ grid-template-columns:1fr; } }
  .about-text { color:var(--text-sub); font-size:.95rem; }
  .about-text p { margin-bottom:1rem; }

  /* ── Services ── */
  .services-grid {
    display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:16px;
  }
  .service-card {
    background:var(--card-bg);
    border:1px solid var(--border);
    padding:28px 16px; text-align:center;
    border-radius:14px;
    box-shadow:0 2px 12px rgba(184,134,11,.08);
    transition:all .25s;
  }
  .service-card:hover { box-shadow:0 6px 24px rgba(184,134,11,.2); transform:translateY(-3px); }
  .service-icon { font-size:2rem; margin-bottom:12px; }
  .service-name { font-size:.85rem; color:var(--text-main); letter-spacing:.05em; }

  /* ── Gallery ── */
  .gallery-grid {
    display:grid; grid-template-columns:repeat(3,1fr); gap:10px;
  }
  @media(max-width:480px){ .gallery-grid{ grid-template-columns:repeat(2,1fr); } }
  .gallery-item {
    aspect-ratio:1;
    background:rgba(255,252,235,.7);
    border:1px solid var(--border);
    display:flex; align-items:center; justify-content:center;
    border-radius:12px; overflow:hidden;
  }
  .gallery-item img { width:100%; height:100%; object-fit:cover; display:block; }
  .gallery-item.fit img { object-fit:contain; padding:8px; }

  /* ── Flow ── */
  .flow-list { list-style:none; max-width:480px; margin:0 auto; }
  .flow-list li {
    display:flex; align-items:flex-start; gap:16px;
    padding:18px 0;
    border-bottom:1px solid rgba(184,134,11,.15);
    color:var(--text-sub); font-size:.95rem;
  }
  .flow-num {
    width:30px; height:30px; flex-shrink:0;
    border:1.5px solid var(--gold); border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    color:var(--gold); font-size:.75rem;
    background:rgba(255,252,235,.8);
  }

  /* ── Pricing ── */
  .price-table { max-width:420px; margin:0 auto; }
